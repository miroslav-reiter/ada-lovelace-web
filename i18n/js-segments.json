    },
    {
      "start": 4094,
      "end": 4231,
      "kind": "literal",
      "source": "Uvažovala o manipulácii s inými symbolmi než číslami a uviedla aj možnosť práce s hudbou. Neznamená to, že vytvorila hudobnú aplikáciu.",
      "id": "t0608"
    },
    {
      "start": 4273,
      "end": 4288,
      "kind": "literal",
      "source": "DETSKÉ NÁPADY",
      "id": "t0609"
    },
    {
      "start": 4291,
      "end": 4333,
      "kind": "literal",
      "source": "S čím súvisel mladícky projekt Flyology?",
      "id": "t0610"
    },
    {
      "start": 4343,
      "end": 4359,
      "kind": "literal",
      "source": "S kompilátormi",
      "id": "t0611"
    },
    {
      "start": 4360,
      "end": 4383,
      "kind": "literal",
      "source": "S lietaním a krídlami",
      "id": "t0612"
    },
    {
      "start": 4384,
      "end": 4416,
      "kind": "literal",
      "source": "S taxonómiou počítačových chýb",
      "id": "t0613"
    },
    {
      "start": 4417,
      "end": 4443,
      "kind": "literal",
      "source": "S marketingom aeroliniek",
      "id": "t0689"
    },
    {
      "start": 4459,
      "end": 4564,
      "kind": "literal",
      "source": "Ako dvanásťročná sa zaujímala o lietanie, krídla a materiály. Projekt nebol hotovým funkčným lietadlom.",
      "id": "t0614"
    },
    {
      "start": 4610,
      "end": 4623,
      "kind": "literal",
      "source": "VZDELÁVANIE",
      "id": "t0615"
    },
    {
      "start": 4626,
      "end": 4684,
      "kind": "literal",
      "source": "S kým Ada korešpondenčne študovala pokročilú matematiku?",
      "id": "t0616"
    },
    {
      "start": 4694,
      "end": 4712,
      "kind": "literal",
      "source": "S Lordom Byronom",
      "id": "t0690"
    },
    {
      "start": 4713,
      "end": 4733,
      "kind": "literal",
      "source": "S Isaacom Newtonom",
      "id": "t0691"
    },
    {
      "start": 4734,
      "end": 4754,
      "kind": "literal",
      "source": "S chatbotom ČajGPT",
      "id": "t0617"
    },
    {
      "start": 4755,
      "end": 4779,
      "kind": "literal",
      "source": "S Augustom De Morganom",
      "id": "t0692"
    },
    {
      "start": 4795,
      "end": 4901,
      "kind": "literal",
      "source": "Jej matematické listy s Augustom De Morganom z rokov 1840 – 1841 sú dôležitým prameňom o jej vzdelávaní.",
      "id": "t0618"
    },
    {
      "start": 4945,
      "end": 4956,
      "kind": "literal",
      "source": "JAZYK ADA",
      "id": "t0693"
    },
    {
      "start": 4959,
      "end": 5016,
      "kind": "literal",
      "source": "Aký vzťah má Ada Lovelace k programovaciemu jazyku Ada?",
      "id": "t0619"
    },
    {
      "start": 5026,
      "end": 5052,
      "kind": "literal",
      "source": "Napísala jeho kompilátor",
      "id": "t0620"
    },
    {
      "start": 5053,
      "end": 5079,
      "kind": "literal",
      "source": "Používala ho v roku 1843",
      "id": "t0621"
    },
    {
      "start": 5080,
      "end": 5116,
      "kind": "literal",
      "source": "Jazyk bol pomenovaný na jej počesť",
      "id": "t0622"
    },
    {
      "start": 5117,
      "end": 5144,
      "kind": "literal",
      "source": "Je to jej tajný pseudonym",
      "id": "t0623"
    },
    {
      "start": 5160,
      "end": 5273,
      "kind": "literal",
      "source": "Jazyk vznikol až v 20. storočí a prvý štandard vyšiel v roku 1983. Ada Lovelace ho nevytvorila; nesie jej meno.",
      "id": "t0624"
    },
    {
      "start": 5313,
      "end": 5336,
      "kind": "literal",
      "source": "SKUTOČNOSŤ ČI RECESIA",
      "id": "t0625"
    },
    {
      "start": 5339,
      "end": 5399,
      "kind": "literal",
      "source": "Ktorý z týchto projektov je na našom webe úplne vymyslený?",
      "id": "t0626"
    },
    {
      "start": 5421,
      "end": 5437,
      "kind": "literal",
      "source": "Poznámky A – G",
      "id": "t0627"
    },
    {
      "start": 5438,
      "end": 5468,
      "kind": "literal",
      "source": "Postup pre Bernoulliho čísla",
      "id": "t0628"
    },
    {
      "start": 5469,
      "end": 5488,
      "kind": "literal",
      "source": "Skúmanie lietania",
      "id": "t0629"
    },
    {
      "start": 5504,
      "end": 5612,
      "kind": "literal",
      "source": "TeaScript je náš fiktívny čajový jazyk. Skutočný programovací jazyk Ada nájdete na samostatnej podstránke.",
      "id": "t0630"
    },
    {
      "start": 5652,
      "end": 5673,
      "kind": "literal",
      "source": "DEJINY BEZ SKRATIEK",
      "id": "t0694"
    },
    {
      "start": 5676,
      "end": 5716,
      "kind": "literal",
      "source": "Ktoré tvrdenie o Ade je najpresnejšie?",
      "id": "t0631"
    },
    {
      "start": 5726,
      "end": 5756,
      "kind": "literal",
      "source": "Vynašla všetky počítače sama",
      "id": "t0632"
    },
    {
      "start": 5757,
      "end": 5820,
      "kind": "literal",
      "source": "Bola priekopníčkou; presné označenie „prvá“ potrebuje kontext",
      "id": "t0633"
    },
    {
      "start": 5821,
      "end": 5854,
      "kind": "literal",
      "source": "Napísala prvú mobilnú aplikáciu",
      "id": "t0634"
    },
    {
      "start": 5855,
      "end": 5886,
      "kind": "literal",
      "source": "Založila prvý cloud v Londýne",
      "id": "t0635"
    },
    {
      "start": 5902,
      "end": 6089,
      "kind": "literal",
      "source": "Je často označovaná za prvú programátorku najmä pre publikovaný postup z roku 1843. Babbage mal aj skoršie nepublikované postupy; jej odkaz zahŕňa tiež širšiu víziu výpočtových strojov.",
      "id": "t0636"
    },
    {
      "start": 6415,
